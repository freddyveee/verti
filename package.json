{
  "name": "verti",
  "productName": "Verti",
  "version": "1.0.13",
  "description": "Vertikaler Browser: Google Kalender, WhatsApp, Todoist, ChatGPT in einer App",
  "author": "IMPERIO <freddy@imperio.rocks>",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --dir"
  },
  "build": {
    "appId": "rocks.imperio.verti",
    "productName": "Verti",
    "publish": [
      { "provider": "github", "owner": "freddyveee", "repo": "verti" }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Verti braucht Zugriff auf das Mikrofon, damit deine Apps Sprachnachrichten und Anrufe ermöglichen können.",
        "NSCameraUsageDescription": "Verti braucht Zugriff auf die Kamera für Videoanrufe in deinen Apps."
      },
      "target": [
        { "target": "dmg", "arch": ["universal"] },
        { "target": "zip", "arch": ["universal"] }
      ],
      "artifactName": "Verti-Mac.${ext}"
    },
    "dmg": {
      "title": "Verti ${version}",
      "writeUpdateInfo": false,
      "background": "build/dmg-background.tiff"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "artifactName": "Verti-Windows-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "differentialPackage": false
    },
    "files": [
      "main.js",
      "preload.js",
      "sidebar.html",
      "update.html",
      "update-preload.js",
      "view-preload.js",
      "screen-picker.html",
      "screen-picker-preload.js",
      "icons/**"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.7.0"
  }
}
