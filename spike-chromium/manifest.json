{
  "manifest_version": 3,
  "name": "Verti",
  "version": "0.1",
  "description": "Verti-Sidebar als Chromium-Erweiterung (Machbarkeitsnachweis)",
  "permissions": ["sidePanel", "tabs", "storage", "notifications"],
  "host_permissions": ["<all_urls>"],
  "side_panel": { "default_path": "sidebar.html" },
  "background": { "service_worker": "sw.js" },
  "action": { "default_title": "Verti" }
}
