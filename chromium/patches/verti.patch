diff --git a/chrome/BUILD.gn b/chrome/BUILD.gn
index 6f97b7046d..4ff859ea4f 100644
--- a/chrome/BUILD.gn
+++ b/chrome/BUILD.gn
@@ -517,13 +517,23 @@ if (is_win) {
     ]
     if (enable_updater) {
       args += [ "--privileged_helper_id=$privileged_helper_name" ]
-      if (is_chrome_branded) {
-        args += [ "--keystone=1" ]
-        if (current_cpu == "arm64") {
-          args += [ "--keystone-base-tag=arm64" ]
-        }
-      } else {
-        args += [ "--keystone=0" ]
+
+      # Verti: die Keystone-Schluessel muessen auch bei uns ins Info.plist.
+      # Ohne KSProductID/KSVersion/KSUpdateURL bricht das Installationsskript
+      # mit "couldn't determine update_version_ks" ab, und der Browser bindet
+      # den Updater gar nicht erst ein (siehe BrowserHasKSProductID).
+      #
+      # KSProductID bleibt bewusst die BUNDLE-Kennung. Auf dem Mac meldet sich
+      # der Browser naemlich genau darunter an
+      # (BrowserUpdaterClient::GetAppId() gibt die Bundle-Kennung zurueck) -
+      # Chrome macht es mit "com.google.chrome" nicht anders. Setzt man hier
+      # etwas anderes, laufen Info.plist und Anmeldung auseinander.
+      args += [
+        "--keystone=1",
+        "--keystone-update-url=$update_check_url",
+      ]
+      if (current_cpu == "arm64") {
+        args += [ "--keystone-base-tag=arm64" ]
       }
     } else {
       args += [ "--keystone=0" ]
