 void ChromeBrowserMainPartsMac::PostProfileInit(Profile* profile,
                                                 bool is_initial_profile) {
   ChromeBrowserMainPartsPosix::PostProfileInit(profile, is_initial_profile);
+
+#if BUILDFLAG(ENABLE_UPDATER)
+  // Verti: sich selbst beim Updater anmelden.
+  //
+  // Chromium ruft EnsureUpdater() nur, wenn jemand die "Ueber"-Seite oeffnet.
+  // Bei Verti soll der Nutzer dafuer gar nichts tun muessen - Updates sollen
+  // einfach ankommen.
+  //
+  // Der Aufruf ist gutmuetig: ist der Updater schon da und Verti angemeldet,
+  // tut er nichts. Er laeuft mit niedrigster Prioritaet und erst 20 Sekunden
+  // nach dem Start, damit der Start nicht langsamer wird.
+  //
+  // WICHTIG: EnsureUpdater() gehoert auf den OBERFLAECHEN-Strang. Chromium
+  // selbst ruft es aus der "Ueber"-Seite heraus, also von dort
+  // (version_updater_mac.mm). Zwei Fehlversuche am 02.09.2026, beide gemessen:
+  //   - ThreadPool::PostDelayedTask  -> SIGSEGV nach 20 s (gar kein Strang)
+  //   - eigener sequenzierter Strang -> SIGABRT, "DCHECK failed:
+  //     checker.CalledOnValidSequence" (falscher Strang)
+  // PostProfileInit laeuft bereits auf dem Oberflaechen-Strang, wir haengen
+  // die Aufgabe also einfach dort verzoegert an.
+  if (is_initial_profile) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&updater::EnsureUpdater,
+                       base::TaskPriority::BEST_EFFORT, base::DoNothing(),
+                       base::DoNothing()),
+        base::Seconds(20));
+  }
+#endif  // BUILDFLAG(ENABLE_UPDATER)
 }
 
