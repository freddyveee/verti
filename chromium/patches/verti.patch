+void ComponentLoader::AddVertiSidebar() {
+  // Verti: die Sidebar IST Verti. Ohne sie waere das hier ein Chromium mit
+  // anderem Namen - genau das ist am 03.09.2026 beim ersten Test passiert:
+  // die Dateien lagen im Paket, aber nichts hat sie geladen (in den Tests
+  // wurde immer --load-extension von Hand mitgegeben).
+  //
+  // Sie liegt in den Resources des Frameworks, weil DIR_RESOURCES auf dem Mac
+  // genau dorthin zeigt. Der Schluessel im Manifest sorgt fuer eine feste
+  // Kennung, damit Einstellungen und App-Auswahl ein Update ueberleben.
+  base::FilePath resources;
+  if (!base::PathService::Get(chrome::DIR_RESOURCES, &resources)) {
+    return;
+  }
+  const base::FilePath sidebar =
+      resources.Append(FILE_PATH_LITERAL("verti-sidebar"));
+  if (!base::PathExists(sidebar.Append(FILE_PATH_LITERAL("manifest.json")))) {
+    LOG(ERROR) << "Verti: Sidebar nicht gefunden unter " << sidebar;
+    return;
+  }
+  AddOrReplace(sidebar);
+}
