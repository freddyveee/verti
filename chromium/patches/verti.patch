+// Verti: die eigene App-Leiste einpassen.
+//
+// Aufbau wie in der Electron-Fassung: sidebar.html nimmt das GANZE Fenster ein
+// (sie bringt Kopfzeile, Leiste und die Ueberlagerungen fuer Bibliothek und
+// Einstellungen selbst mit), der Inhalt liegt darueber - eingerueckt um die
+// Leistenbreite links und die Kopfzeilenhoehe oben. Was der Nutzer als "L"
+// wahrnimmt, sind die freigelassenen Raender.
+//
+// Die Zahlen muessen zu sidebar.html passen:
+//   .sidebar { width: 68px; top: 44px; }
+//
+// WICHTIG: Das gehoert NICHT in DoPostLayoutVisualAdjustments(). Fuer normale
+// Fenster ueberschreibt BrowserViewTabbedLayoutImpl diesen Haken, ohne die
+// Basis zu rufen - der Code lief dort nie, und die Leiste blieb unsichtbar,
+// obwohl sie geladen war (am 03.09.2026 genau so gemessen).
+void BrowserViewLayoutImpl::LayoutVertiSidebar() {
+  if (!views().verti_sidebar || !views().browser_view) {
+    return;
+  }
+  constexpr int kVertiLeisteBreite = 68;
+  constexpr int kVertiKopfzeileHoehe = 44;
+
+  const gfx::Rect fenster = views().browser_view->GetLocalBounds();
+  views().verti_sidebar->SetBoundsRect(fenster);
+  views().verti_sidebar->SetVisible(true);
+
+  gfx::Rect inhalt = fenster;
+  inhalt.Inset(
+      gfx::Insets::TLBR(kVertiKopfzeileHoehe, kVertiLeisteBreite, 0, 0));
+
+  // Hinweisleisten (z.B. "Sitzung wiederhergestellt") gehoeren ebenfalls in den
+  // Inhaltsbereich. Ohne das legen sie sich ueber Vertis Kopfzeile und
+  // verdecken Wortmarke, Navigation und Zahnrad.
+  if (views().infobar_container && views().infobar_container->GetVisible()) {
+    const int hoehe = views().infobar_container->GetPreferredSize().height();
+    gfx::Rect leiste = inhalt;
+    leiste.set_height(hoehe);
+    views().infobar_container->SetBoundsRect(leiste);
+    inhalt.Inset(gfx::Insets::TLBR(hoehe, 0, 0, 0));
+  }
+
+  if (views().multi_contents_view) {
+    views().multi_contents_view->SetBoundsRect(inhalt);
+  }
+}
