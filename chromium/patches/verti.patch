+    // nagelt crx_pkhash (siehe branding.gni) unseren Signierschluessel fest:
+    // der Updater nimmt dann NUR Pakete an, die wir selbst signiert haben.
+    // Fuer ein Produkt mit einem einzigen Herausgeber ist das derselbe Schutz.
+    return crx_file::VerifierFormat::CRX3;
